POSTGRES_DB=ima_studio
POSTGRES_USER=ima_user
POSTGRES_PASSWORD=mot_de_passe_securise
DATABASE_URL=postgresql://ima_user:mot_de_passe_securise@localhost:5432/ima_studio
NEXTAUTH_SECRET=remplacer_par_cle_secrete_longue
ADMIN_PASSWORD=remplacer_par_un_mot_de_passe_admin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Notifications email (Brevo) — https://app.brevo.com → SMTP & API > Clés API
BREVO_API_KEY=xkeysib-remplacer_par_votre_cle_api_brevo
# Expéditeur : doit être un expéditeur/domaine VALIDÉ dans Brevo
NOTIF_SENDER_EMAIL=studio@semecity.com
NOTIF_SENDER_NAME=IMA Studio
# Notifications WhatsApp (branchées plus tard) — laisser vide pour l'instant.
# Définir WHATSAPP_PROVIDER activera l'appel à sendWhatsApp() (Meta/Twilio).
WHATSAPP_PROVIDER=
